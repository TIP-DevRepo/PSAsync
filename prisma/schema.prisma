generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── COMPANY ─────────────────────────────────────────────────────────────────
model Company {
  id               String   @id @default(cuid())
  name             String
  email            String?
  phone            String?
  website          String?
  address          String?
  city             String?
  state            String?
  zip              String?
  country          String   @default("US")
  logoUrl          String?
  secondaryLogoUrl String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users                   User[]
  clients                 Client[]
  industries              Industry[]
  categories              Category[]
  inventoryLocations      InventoryLocation[]
  inventoryCustomFields   InventoryCustomField[]
  vendors                 Vendor[]
  quotes                  Quote[]
  salesOrders             SalesOrder[]
  purchaseOrders          PurchaseOrder[]
  catalogItems            CatalogItem[]
  settings                CompanySettings?
  distributorIntegrations DistributorIntegration[]
  microsoftConnections    MicrosoftConnection[]
  approvalWorkflows       ApprovalWorkflow[]
  roles                   Role[]
  contactTags             ContactTag[]
  inventoryAssets         InventoryAsset[]
  inventoryStocks         InventoryStock[]
  dashboards              Dashboard[]
  opportunities           Opportunity[]
  opportunityStages       OpportunityStage[]
  opportunityTypes        OpportunityType[]
  opportunitySettings     OpportunitySettings?
  timelineEntries         TimelineEntry[]
  teams                   Team[]
  actionButtons           ActionButton[]
  auditLogEntries         AuditLogEntry[]
}

// ─── COMPANY SETTINGS ────────────────────────────────────────────────────────
model CompanySettings {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id])

  // Quote settings
  quotePrefix               String               @default("Q")
  quoteExpiryDays           Int                  @default(30)
  quoteTerms                String?              @db.Text
  quoteDefaultCc            String?
  quoteApprovalThreshold    Float?
  quoteSendFromMode         String               @default("CREATOR")
  quoteSendFromConnectionId String?
  quoteSendFromConnection   MicrosoftConnection? @relation(fields: [quoteSendFromConnectionId], references: [id])

  // SO/PO settings
  soPrefix             String @default("SO")
  poPrefix             String @default("PO")
  poDefaultPaymentType String @default("Net30")
  // Per-status notify rule: { READY_TO_INVOICE: { type: "user"|"role", id }, READY_TO_ORDER: {...}, READY_TO_CLOSEOUT: {...} }
  soStatusNotifyRules  Json?

  // Branding
  primaryColor String @default("#1B3A5C")
  accentColor  String @default("#2E86AB")

  // Email settings
  microsoftClientId     String?
  microsoftTenantId     String?
  microsoftClientSecret String? @db.Text
  ssoEnabled            Boolean @default(false)
  emailDefaultCc        String?
  emailSignature        String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── USER ─────────────────────────────────────────────────────────────────────
model User {
  id                    String     @id @default(cuid())
  companyId             String
  company               Company    @relation(fields: [companyId], references: [id])
  name                  String
  email                 String     @unique
  password              String?
  // Legacy single role, kept for one release so a rollback to the
  // previous code still works. Never read for permission checks anymore:
  // real access comes from userRoles (plus the company's Everyone role)
  // via getEffectiveAccess in src/lib/permissions.ts. Kept in sync with
  // the user's highest ranked assigned role by src/lib/user-roles.ts.
  roleId                String?
  role                  Role?      @relation(fields: [roleId], references: [id])
  userRoles             UserRole[] @relation("UserRoleUser")
  active                Boolean    @default(true)
  maxDiscount           Float      @default(10)
  microsoftId           String?    @unique
  preferredDistributors String[]   @default([])
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  // Rate limit for wrong current password attempts on My Account. Kept in
  // the database because serverless instances don't share memory.
  passwordChangeFailedAttempts Int       @default(0)
  passwordChangeLockedUntil    DateTime?

  // Rate limit for wrong password attempts on the login page. Separate
  // from the password change counter above so neither can reset the other.
  loginFailedAttempts Int       @default(0)
  loginLockedUntil    DateTime?

  // Set when an admin invites someone with a temporary password. Until they
  // choose their own, getEffectiveAccess gives them no access at all and
  // the dashboard sends them to /change-password.
  mustChangePassword Boolean @default(false)

  // Which dashboard loads for this user at /dashboard — their own, or
  // the shared company Default. Null means "use the company Default,"
  // same as if they'd never picked one. Cleared automatically if that
  // dashboard is later deleted.
  defaultDashboardId String?
  defaultDashboard   Dashboard? @relation("UserDefaultDashboard", fields: [defaultDashboardId], references: [id], onDelete: SetNull)

  quotes                      Quote[]
  salesOrders                 SalesOrder[]
  purchaseOrders              PurchaseOrder[]
  sessions                    Session[]
  notifications               Notification[]
  connectedMicrosoftMailboxes MicrosoftConnection[]
  quoteComments               QuoteComment[]
  soComments                  SOComment[]
  poComments                  POComment[]
  soAttachments               SOAttachment[]
  poAttachments               POAttachment[]
  vendorAttachments           VendorAttachment[]
  catalogItemChangeLogs       CatalogItemChangeLog[]
  triggeredWorkflows          ApprovalWorkflow[]         @relation("WorkflowTriggerUser")
  approvalDecisions           QuoteApproval[]            @relation("ApprovalDecidedBy")
  assignedInventoryAssets     InventoryAsset[]           @relation("InventoryAssetAssignedUser")
  inventoryAssetEvents        InventoryAssetEvent[]
  inventoryStockEvents        InventoryStockEvent[]
  inventoryAssetAttachments   InventoryAssetAttachment[]
  dashboards                  Dashboard[]                @relation("DashboardOwner")
  ownedOpportunities          Opportunity[]              @relation("OpportunityOwner")
  createdOpportunities        Opportunity[]              @relation("OpportunityCreatedBy")
  opportunityAttachments      OpportunityAttachment[]
  timelineEntries             TimelineEntry[]
  teamMemberships             TeamMember[]
  deletedOpportunities        Opportunity[]              @relation("OpportunityDeletedBy")
  auditLogEntries             AuditLogEntry[]            @relation("AuditLogActor")
  undoneAuditLogEntries       AuditLogEntry[]            @relation("AuditLogUndoneBy")
}

// ─── SESSION (Auth.js) ───────────────────────────────────────────────────────
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

// ─── CLIENT ──────────────────────────────────────────────────────────────────
model Client {
  id                 String       @id @default(cuid())
  companyId          String
  company            Company      @relation(fields: [companyId], references: [id])
  name               String
  prefix             String?
  nextAssetSequence  Int          @default(1)
  email              String?
  phone              String?
  website            String?
  industryId         String?
  industryRef        Industry?    @relation(fields: [industryId], references: [id])
  status             ClientStatus @default(PROSPECT)
  source             String?
  tags               String[]
  creditLimit        Float?
  paymentTerms       String?
  notes              String?      @db.Text
  isInternal         Boolean      @default(false)
  inventoryOnboarded Boolean      @default(false)

  // Main billing/shipping now point at one of this client's Locations
  // rather than storing free-text address fields directly — the actual
  // address/contact shown is derived from whichever Location is picked.
  mainBillingLocationId  String?
  mainBillingLocation    ClientLocation? @relation("ClientMainBilling", fields: [mainBillingLocationId], references: [id])
  mainShippingLocationId String?
  mainShippingLocation   ClientLocation? @relation("ClientMainShipping", fields: [mainShippingLocationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts              Contact[]
  locations             ClientLocation[]    @relation("ClientLocations")
  quotes                Quote[]
  salesOrders           SalesOrder[]
  customPricing         ClientCustomPrice[]
  ownedInventoryAssets  InventoryAsset[]    @relation("InventoryAssetOwner")
  loanedInventoryAssets InventoryAsset[]    @relation("InventoryAssetLoanedTo")
  purchaseOrders        PurchaseOrder[]
  opportunities         Opportunity[]
}

model Industry {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  createdAt DateTime @default(now())

  clients Client[]

  @@unique([companyId, name])
}

model ClientLocation {
  id        String  @id @default(cuid())
  clientId  String
  client    Client  @relation("ClientLocations", fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  address2  String?
  city      String?
  state     String?
  zip       String?
  country   String?
  phone     String?
  notes     String?
  isPrimary Boolean @default(false)

  billingContactId  String?
  billingContact    Contact? @relation("LocationBillingContact", fields: [billingContactId], references: [id])
  shippingContactId String?
  shippingContact   Contact? @relation("LocationShippingContact", fields: [shippingContactId], references: [id])

  // Back-relation for Contact.location — contacts who work at this site
  contactsBasedHere Contact[]

  // Opportunities at this location
  opportunities Opportunity[]

  // Every Container built under this site — the reverse side of
  // InventoryLocation.clientLocationId below.
  containers InventoryLocation[] @relation("InventoryLocationSite")

  // The Container pre-selected in the receiving popup when stocking
  // hardware at this site — optional, set from inside the Containers
  // popup. Must belong to this same ClientLocation's own tree.
  defaultContainerId String?
  defaultContainer   InventoryLocation? @relation("ClientLocationDefaultContainer", fields: [defaultContainerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Back-relations required by Prisma since Client links to ClientLocation
  // through two additional named relations beyond the primary "locations" one
  mainBillingForClients  Client[] @relation("ClientMainBilling")
  mainShippingForClients Client[] @relation("ClientMainShipping")

  purchaseOrdersReceivingHere PurchaseOrder[]  @relation("PurchaseOrderReceivingLocation")
  purchaseOrdersShippingHere  PurchaseOrder[]  @relation("PurchaseOrderShipToLocation")
  inventoryAssets             InventoryAsset[]

  @@index([clientId])
}

enum ClientStatus {
  ACTIVE
  PROSPECT
  INACTIVE
  LOST
}

// ─── CONTACT ─────────────────────────────────────────────────────────────────
model Contact {
  id           String              @id @default(cuid())
  clientId     String
  client       Client              @relation(fields: [clientId], references: [id])
  firstName    String
  lastName     String
  title        String?
  email        String?
  phone        String? // Work phone
  mobile       String? // Cell phone
  locationType ContactLocationType @default(IN_OFFICE)
  locationId   String?
  location     ClientLocation?     @relation(fields: [locationId], references: [id])
  isPrimary    Boolean             @default(false)
  role         String?
  notes        String?             @db.Text
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  quotes                    Quote[]
  billingForLocations       ClientLocation[]       @relation("LocationBillingContact")
  shippingForLocations      ClientLocation[]       @relation("LocationShippingContact")
  tags                      ContactTagAssignment[]
  inventoryAssetsLoanedTo   InventoryAsset[]       @relation("InventoryAssetLoanedToContact")
  inventoryAssetsDeployedTo InventoryAsset[]       @relation("InventoryAssetDeployedToContact")
  opportunities             Opportunity[]
}

// ─── CONTACT TAG ─────────────────────────────────────────────────────────────
model ContactTag {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  color     String?
  createdAt DateTime @default(now())

  contacts ContactTagAssignment[]

  @@unique([companyId, name])
}

model ContactTagAssignment {
  id           String     @id @default(cuid())
  contactId    String
  contact      Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactTagId String
  contactTag   ContactTag @relation(fields: [contactTagId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([contactId, contactTagId])
}

enum ContactLocationType {
  REMOTE
  IN_OFFICE
}

// ─── VENDOR ──────────────────────────────────────────────────────────────────
model Vendor {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  name           String
  type           VendorType   @default(SUPPLIER)
  status         VendorStatus @default(ACTIVE)
  email          String?
  phone          String?
  website        String?
  address        String?
  paymentTerms   String?
  leadTimeDays   Int?
  notes          String?      @db.Text
  isDistributor  Boolean      @default(false)
  distributorKey String?
  isVendor       Boolean      @default(true)
  isManufacturer Boolean      @default(false)
  logoUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  catalogItems                  CatalogItem[]      @relation("CatalogItemVendor")
  catalogItemsAsMaker           CatalogItem[]      @relation("CatalogItemManufacturer")
  purchaseOrders                PurchaseOrder[]
  soLineItems                   SOLineItem[]
  locations                     VendorLocation[]
  contacts                      VendorContact[]
  attachments                   VendorAttachment[]
  inventoryAssetsAsVendor       InventoryAsset[]   @relation("InventoryAssetOverrideVendor")
  inventoryAssetsAsManufacturer InventoryAsset[]   @relation("InventoryAssetOverrideManufacturer")
}

// ─── VENDOR LOCATION ──────────────────────────────────────────────────────
model VendorLocation {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  address2  String?
  city      String?
  state     String?
  zip       String?
  country   String?
  phone     String?
  notes     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts VendorContact[]
}

// ─── VENDOR CONTACT ───────────────────────────────────────────────────────
model VendorContact {
  id         String          @id @default(cuid())
  vendorId   String
  vendor     Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  title      String?
  email      String?
  phone      String?
  mobile     String?
  locationId String?
  location   VendorLocation? @relation(fields: [locationId], references: [id])
  isPrimary  Boolean         @default(false)
  notes      String?         @db.Text
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

// ─── VENDOR ATTACHMENTS ───────────────────────────────────────────────────
model VendorAttachment {
  id               String   @id @default(cuid())
  vendorId         String
  vendor           Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  fileName         String
  fileUrl          String
  fileSize         Int?
  uploadedByUserId String
  uploadedByUser   User     @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime @default(now())
}

enum VendorType {
  SUPPLIER
  SUBCONTRACTOR
  PARTNER
  DISTRIBUTOR
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  PREFERRED
}

// ─── CATEGORY ─────────────────────────────────────────────────────────────
model Category {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id])
  name      String
  parentId  String?
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryChildren")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  catalogItems CatalogItem[]
  customFields InventoryCustomField[]

  // Default applied to the "Serialized" checkbox when creating a new
  // Catalog Item under this category, editing an existing item never
  // auto-applies this, only the Add Catalog Item form does.
  defaultIsSerialized Boolean @default(false)

  // Name must be unique per company regardless of where it sits in the
  // tree, no two categories anywhere can share a name, even under
  // different parents (e.g. only one "Cables" category ever exists).
  @@unique([companyId, name])
}

// ─── INVENTORY CUSTOM FIELD ─────────────────────────────────────────────────
// Field definitions only, at this phase. The values (InventoryCustomFieldValue)
// get built in Phase 5 alongside InventoryAsset, since a value has to attach
// to an actual asset record, which doesn't exist yet.
model InventoryCustomField {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  values InventoryCustomFieldValue[]

  // Field names only need to be unique within their own category, two
  // different categories can each have their own "Color" field.
  @@unique([categoryId, name])
}

// ─── INVENTORY STOCK ─────────────────────────────────────────────────────────
// Pooled quantity tracking for non-serialized Catalog Items (cables, mice,
// etc). One row per Catalog Item + Location combination — no individual
// unit records and no Asset Tag, just a running count.
model InventoryStock {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])

  locationId String
  location   InventoryLocation @relation(fields: [locationId], references: [id])

  quantity Int @default(0)

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  inventoryStockEvents InventoryStockEvent[]

  @@unique([catalogItemId, locationId])
}

// ─── INVENTORY ASSET ATTACHMENTS ─────────────────────────────────────────────
model InventoryAssetAttachment {
  id               String         @id @default(cuid())
  assetId          String
  asset            InventoryAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fileName         String
  fileUrl          String
  fileSize         Int?
  uploadedByUserId String
  uploadedByUser   User           @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime       @default(now())
}

// ─── INVENTORY EVENTS (AUDIT TRAIL) ──────────────────────────────────────────
enum InventoryEventType {
  CREATED
  STATUS_CHANGED
  CHECKED_OUT
  RETURNED
  MOVED
  FIELD_UPDATED
}

model InventoryAssetEvent {
  id      String         @id @default(cuid())
  assetId String
  asset   InventoryAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  eventType   InventoryEventType
  description String             @db.Text

  // Nullable so future automated events (not directly triggered by
  // someone clicking a button) don't require a fabricated user.
  performedByUserId String?
  performedByUser   User?   @relation(fields: [performedByUserId], references: [id])

  createdAt DateTime @default(now())
}

enum InventoryStockEventType {
  RECEIVED
  CHECKED_OUT
  ADJUSTED
  MOVED
}

model InventoryStockEvent {
  id      String         @id @default(cuid())
  stockId String
  stock   InventoryStock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  eventType      InventoryStockEventType
  // Positive for increases (received, adjusted up), negative for
  // decreases (checked out, adjusted down).
  quantityChange Int
  description    String                  @db.Text

  performedByUserId String?
  performedByUser   User?   @relation(fields: [performedByUserId], references: [id])

  createdAt DateTime @default(now())
}

// ─── INVENTORY LOCATION ─────────────────────────────────────────────────────
// A "Container" tree — shelves, racks, slots — built underneath a specific
// physical ClientLocation. Every client (including your own internal one)
// has its Containers scoped to one of their own sites, there's no more
// separate global company-wide warehouse tree — your own company's
// Containers work exactly the same way, just under your own ClientLocation.
model InventoryLocation {
  id                        String              @id @default(cuid())
  companyId                 String
  company                   Company             @relation(fields: [companyId], references: [id])
  clientLocationId          String
  clientLocation            ClientLocation      @relation("InventoryLocationSite", fields: [clientLocationId], references: [id], onDelete: Cascade)
  name                      String
  parentId                  String?
  parent                    InventoryLocation?  @relation("InventoryLocationChildren", fields: [parentId], references: [id])
  children                  InventoryLocation[] @relation("InventoryLocationChildren")
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  inventoryStocks           InventoryStock[]
  inventoryAssets           InventoryAsset[]
  defaultForClientLocations ClientLocation[]    @relation("ClientLocationDefaultContainer")
}

// ─── CATALOG ITEM ─────────────────────────────────────────────────────────────
model CatalogItem {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  vendorId        String?
  vendor          Vendor?  @relation("CatalogItemVendor", fields: [vendorId], references: [id])
  vendorSku       String?
  manufacturerId  String?
  manufacturer    Vendor?  @relation("CatalogItemManufacturer", fields: [manufacturerId], references: [id])
  manufacturerSku String?
  name            String
  description     String?  @db.Text
  categoryId      String
  categoryRef     Category @relation(fields: [categoryId], references: [id])
  isSerialized    Boolean  @default(false)
  type            ItemType @default(PHYSICAL)
  msrp            Float    @default(0)
  cost            Float    @default(0)
  unit            String   @default("each")
  taxable         Boolean  @default(true)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  quoteLineItems    QuoteLineItem[]
  customPricing     ClientCustomPrice[]
  templateLineItems QuoteTemplateLineItem[]
  soLineItems       SOLineItem[]
  poLineItems       POLineItem[]
  changeLogs        CatalogItemChangeLog[]
  inventoryAssets   InventoryAsset[]
  inventoryStocks   InventoryStock[]
}

// ─── CATALOG ITEM CHANGE LOG ──────────────────────────────────────────────
model CatalogItemChangeLog {
  id              String      @id @default(cuid())
  catalogItemId   String
  catalogItem     CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  changedByUserId String
  changedByUser   User        @relation(fields: [changedByUserId], references: [id])
  fieldName       String
  oldValue        String?
  newValue        String?
  createdAt       DateTime    @default(now())
}

enum ItemType {
  PHYSICAL
  SERVICE
  SUBSCRIPTION
  BUNDLE
}

// ─── CLIENT CUSTOM PRICING ───────────────────────────────────────────────────
model ClientCustomPrice {
  id            String      @id @default(cuid())
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])
  price         Float
  createdAt     DateTime    @default(now())
}

// ─── QUOTE ───────────────────────────────────────────────────────────────────
model Quote {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  quoteNumber         String
  version             Int            @default(1)
  parentId            String?
  isActive            Boolean        @default(true)
  status              QuoteStatus    @default(DRAFT)
  templateId          String?
  template            QuoteTemplate? @relation(fields: [templateId], references: [id])
  title               String?
  introText           String?        @db.Text
  terms               String?        @db.Text
  useDefaultTerms     Boolean        @default(true)
  internalNotes       String?        @db.Text
  clientPoNumber      String?
  paymentTerms        String?
  shipAddress         String?
  shipAddress2        String?
  shipCity            String?
  shipState           String?
  shipZip             String?
  shipCountry         String?
  shipContactName     String?
  expiresAt           DateTime?
  sentAt              DateTime?
  viewedAt            DateTime?
  acceptedAt          DateTime?
  declinedAt          DateTime?
  declineReason       String?
  signatureType       String?
  signatureData       String?        @db.Text
  signerName          String?
  termsAgreedAt       DateTime?
  portalComment       String?        @db.Text
  portalCommentAt     DateTime?
  lastCommentViewedAt DateTime?
  accessToken         String         @unique @default(cuid())
  internalAccessToken String         @unique @default(cuid())
  taxRate             Float          @default(0)
  pendingEmailPayload Json?
  flagged             Boolean        @default(false)
  sections            String[]       @default([])

  // The opportunity this quote belongs to, if any. Deleting a linked
  // opportunity is refused by the app, and by the database.
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems  QuoteLineItem[]
  salesOrder SalesOrder?
  approvals  QuoteApproval[]
  comments   QuoteComment[]

  @@index([opportunityId])
}

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
}

// ─── QUOTE LINE ITEM ─────────────────────────────────────────────────────────
model QuoteLineItem {
  id            String       @id @default(cuid())
  quoteId       String
  quote         Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  catalogItemId String?
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id])

  section            String?
  sortOrder          Int                @default(0)
  name               String
  description        String?            @db.Text
  sku                String?
  quantity           Float              @default(1)
  unitPrice          Float              @default(0)
  cost               Float              @default(0)
  discount           Float              @default(0)
  taxable            Boolean            @default(true)
  isRecurring        Boolean            @default(false)
  recurringInterval  RecurringInterval?
  isOptional         Boolean            @default(false)
  optionalSelected   Boolean            @default(true)
  quantityAdjustable Boolean            @default(false)
  choiceGroup        String?
  isTextBlock        Boolean            @default(false)
  bundleName         String?
  bundleDisplayMode  String?            @default("COLLAPSED")
