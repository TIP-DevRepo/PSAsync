enum RecurringInterval {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

// ─── SALES ORDER ─────────────────────────────────────────────────────────────
model SalesOrder {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  quoteId   String? @unique
  quote     Quote?  @relation(fields: [quoteId], references: [id])
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  soNumber       String
  clientPoNumber String?
  paymentTerms   String?
  status         SalesOrderStatus @default(DRAFT)
  internalNotes  String?          @db.Text
  clientNotes    String?          @db.Text

  // Billing
  billContactName String?
  billAddress     String?
  billAddress2    String?
  billCity        String?
  billState       String?
  billZip         String?
  billCountry     String?

  // Shipping
  shipContactName String?
  shipAddress     String?
  shipAddress2    String?
  shipCity        String?
  shipState       String?
  shipZip         String?
  shipCountry     String?

  // The opportunity this order belongs to, if any. Deleting a linked
  // opportunity is refused by the app, and by the database.
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  lineItems      SOLineItem[]
  comments       SOComment[]
  attachments    SOAttachment[]

  @@index([opportunityId])
}

enum SalesOrderStatus {
  DRAFT
  READY_TO_INVOICE
  INVOICED
  READY_TO_ORDER
  PARTS_ORDERED
  READY_TO_CLOSEOUT
  CLOSED
}

// ─── SO LINE ITEM ─────────────────────────────────────────────────────────────
model SOLineItem {
  id                String             @id @default(cuid())
