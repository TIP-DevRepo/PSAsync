generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── COMPANY ─────────────────────────────────────────────────────────────────
model Company {
  id               String   @id @default(cuid())
  name             String
  email            String?
  phone            String?
  website          String?
  address          String?
  city             String?
  state            String?
  zip              String?
  country          String   @default("US")
  logoUrl          String?
  secondaryLogoUrl String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users                   User[]
  clients                 Client[]
  industries              Industry[]
  categories              Category[]
  inventoryLocations      InventoryLocation[]
  inventoryCustomFields   InventoryCustomField[]
  vendors                 Vendor[]
  quotes                  Quote[]
  salesOrders             SalesOrder[]
  purchaseOrders          PurchaseOrder[]
  catalogItems            CatalogItem[]
  settings                CompanySettings?
  distributorIntegrations DistributorIntegration[]
  microsoftConnections    MicrosoftConnection[]
  approvalWorkflows       ApprovalWorkflow[]
  roles                   Role[]
  contactTags             ContactTag[]
  inventoryAssets         InventoryAsset[]
  inventoryStocks         InventoryStock[]
}

// ─── COMPANY SETTINGS ────────────────────────────────────────────────────────
model CompanySettings {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id])

  // Quote settings
  quotePrefix               String               @default("Q")
  quoteExpiryDays           Int                  @default(30)
  quoteTerms                String?              @db.Text
  quoteDefaultCc            String?
  quoteApprovalThreshold    Float?
  quoteSendFromMode         String               @default("CREATOR")
  quoteSendFromConnectionId String?
  quoteSendFromConnection   MicrosoftConnection? @relation(fields: [quoteSendFromConnectionId], references: [id])

  // SO/PO settings
  soPrefix             String @default("SO")
  poPrefix             String @default("PO")
  poDefaultPaymentType String @default("Net30")
  // Per-status notify rule: { READY_TO_INVOICE: { type: "user"|"role", id }, READY_TO_ORDER: {...}, READY_TO_CLOSEOUT: {...} }
  soStatusNotifyRules  Json?

  // Branding
  primaryColor String @default("#1B3A5C")
  accentColor  String @default("#2E86AB")

  // Email settings
  microsoftClientId     String?
  microsoftTenantId     String?
  microsoftClientSecret String? @db.Text
  ssoEnabled            Boolean @default(false)
  emailDefaultCc        String?
  emailSignature        String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── USER ─────────────────────────────────────────────────────────────────────
model User {
  id                    String   @id @default(cuid())
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id])
  name                  String
  email                 String   @unique
  password              String?
  roleId                String?
  role                  Role?    @relation(fields: [roleId], references: [id])
  active                Boolean  @default(true)
  maxDiscount           Float    @default(10)
  microsoftId           String?  @unique
  preferredDistributors String[] @default([])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  quotes                      Quote[]
  salesOrders                 SalesOrder[]
  purchaseOrders              PurchaseOrder[]
  sessions                    Session[]
  notifications               Notification[]
  connectedMicrosoftMailboxes MicrosoftConnection[]
  quoteComments               QuoteComment[]
  soComments                  SOComment[]
  poComments                  POComment[]
  soAttachments               SOAttachment[]
  poAttachments               POAttachment[]
  vendorAttachments           VendorAttachment[]
  catalogItemChangeLogs       CatalogItemChangeLog[]
  triggeredWorkflows          ApprovalWorkflow[]         @relation("WorkflowTriggerUser")
  approvalDecisions           QuoteApproval[]            @relation("ApprovalDecidedBy")
  assignedInventoryAssets     InventoryAsset[]           @relation("InventoryAssetAssignedUser")
  inventoryAssetEvents        InventoryAssetEvent[]
  inventoryStockEvents        InventoryStockEvent[]
  inventoryAssetAttachments   InventoryAssetAttachment[]
}

// ─── SESSION (Auth.js) ───────────────────────────────────────────────────────
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

// ─── CLIENT ──────────────────────────────────────────────────────────────────
model Client {
  id                String       @id @default(cuid())
  companyId         String
  company           Company      @relation(fields: [companyId], references: [id])
  name              String
  prefix            String?
  nextAssetSequence Int          @default(1)
  email             String?
  phone             String?
  website           String?
  industryId        String?
  industryRef       Industry?    @relation(fields: [industryId], references: [id])
  status            ClientStatus @default(PROSPECT)
  source            String?
  tags              String[]
  creditLimit       Float?
  paymentTerms      String?
  notes             String?      @db.Text
  isInternal        Boolean      @default(false)

  // Main billing/shipping now point at one of this client's Locations
  // rather than storing free-text address fields directly — the actual
  // address/contact shown is derived from whichever Location is picked.
  mainBillingLocationId  String?
  mainBillingLocation    ClientLocation? @relation("ClientMainBilling", fields: [mainBillingLocationId], references: [id])
  mainShippingLocationId String?
  mainShippingLocation   ClientLocation? @relation("ClientMainShipping", fields: [mainShippingLocationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts              Contact[]
  locations             ClientLocation[]    @relation("ClientLocations")
  quotes                Quote[]
  salesOrders           SalesOrder[]
  customPricing         ClientCustomPrice[]
  ownedInventoryAssets  InventoryAsset[]    @relation("InventoryAssetOwner")
  loanedInventoryAssets InventoryAsset[]    @relation("InventoryAssetLoanedTo")
}

model Industry {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  createdAt DateTime @default(now())

  clients Client[]

  @@unique([companyId, name])
}

model ClientLocation {
  id        String  @id @default(cuid())
  clientId  String
  client    Client  @relation("ClientLocations", fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  address2  String?
  city      String?
  state     String?
  zip       String?
  country   String?
  phone     String?
  notes     String?
  isPrimary Boolean @default(false)

  billingContactId  String?
  billingContact    Contact? @relation("LocationBillingContact", fields: [billingContactId], references: [id])
  shippingContactId String?
  shippingContact   Contact? @relation("LocationShippingContact", fields: [shippingContactId], references: [id])

  // Back-relation for Contact.location — contacts who work at this site
  contactsBasedHere Contact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Back-relations required by Prisma since Client links to ClientLocation
  // through two additional named relations beyond the primary "locations" one
  mainBillingForClients  Client[]         @relation("ClientMainBilling")
  mainShippingForClients Client[]         @relation("ClientMainShipping")
  inventoryAssets        InventoryAsset[]
  purchaseOrders         PurchaseOrder[]

  @@index([clientId])
}

enum ClientStatus {
  ACTIVE
  PROSPECT
  INACTIVE
  LOST
}

// ─── CONTACT ─────────────────────────────────────────────────────────────────
model Contact {
  id           String              @id @default(cuid())
  clientId     String
  client       Client              @relation(fields: [clientId], references: [id])
  firstName    String
  lastName     String
  title        String?
  email        String?
  phone        String? // Work phone
  mobile       String? // Cell phone
  locationType ContactLocationType @default(IN_OFFICE)
  locationId   String?
  location     ClientLocation?     @relation(fields: [locationId], references: [id])
  isPrimary    Boolean             @default(false)
  role         String?
  notes        String?             @db.Text
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  quotes               Quote[]
  billingForLocations  ClientLocation[]       @relation("LocationBillingContact")
  shippingForLocations ClientLocation[]       @relation("LocationShippingContact")
  tags                 ContactTagAssignment[]
  inventoryAssets      InventoryAsset[]
}

// ─── CONTACT TAG ─────────────────────────────────────────────────────────────
model ContactTag {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  color     String?
  createdAt DateTime @default(now())

  contacts ContactTagAssignment[]

  @@unique([companyId, name])
}

model ContactTagAssignment {
  id           String     @id @default(cuid())
  contactId    String
  contact      Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactTagId String
  contactTag   ContactTag @relation(fields: [contactTagId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([contactId, contactTagId])
}

enum ContactLocationType {
  REMOTE
  IN_OFFICE
}

// ─── VENDOR ──────────────────────────────────────────────────────────────────
model Vendor {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  name           String
  type           VendorType   @default(SUPPLIER)
  status         VendorStatus @default(ACTIVE)
  email          String?
  phone          String?
  website        String?
  address        String?
  paymentTerms   String?
  leadTimeDays   Int?
  notes          String?      @db.Text
  isDistributor  Boolean      @default(false)
  distributorKey String?
  isVendor       Boolean      @default(true)
  isManufacturer Boolean      @default(false)
  logoUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  catalogItems                  CatalogItem[]      @relation("CatalogItemVendor")
  catalogItemsAsMaker           CatalogItem[]      @relation("CatalogItemManufacturer")
  purchaseOrders                PurchaseOrder[]
  soLineItems                   SOLineItem[]
  locations                     VendorLocation[]
  contacts                      VendorContact[]
  attachments                   VendorAttachment[]
  inventoryAssetsAsVendor       InventoryAsset[]   @relation("InventoryAssetOverrideVendor")
  inventoryAssetsAsManufacturer InventoryAsset[]   @relation("InventoryAssetOverrideManufacturer")
}

// ─── VENDOR LOCATION ──────────────────────────────────────────────────────
model VendorLocation {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  address2  String?
  city      String?
  state     String?
  zip       String?
  country   String?
  phone     String?
  notes     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts VendorContact[]
}

// ─── VENDOR CONTACT ───────────────────────────────────────────────────────
model VendorContact {
  id         String          @id @default(cuid())
  vendorId   String
  vendor     Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  title      String?
  email      String?
  phone      String?
  mobile     String?
  locationId String?
  location   VendorLocation? @relation(fields: [locationId], references: [id])
  isPrimary  Boolean         @default(false)
  notes      String?         @db.Text
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

// ─── VENDOR ATTACHMENTS ───────────────────────────────────────────────────
model VendorAttachment {
  id               String   @id @default(cuid())
  vendorId         String
  vendor           Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  fileName         String
  fileUrl          String
  fileSize         Int?
  uploadedByUserId String
  uploadedByUser   User     @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime @default(now())
}

enum VendorType {
  SUPPLIER
  SUBCONTRACTOR
  PARTNER
  DISTRIBUTOR
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  PREFERRED
}

// ─── CATEGORY ─────────────────────────────────────────────────────────────
model Category {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id])
  name      String
  parentId  String?
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryChildren")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  catalogItems CatalogItem[]
  customFields InventoryCustomField[]

  // Default applied to the "Serialized" checkbox when creating a new
  // Catalog Item under this category, editing an existing item never
  // auto-applies this, only the Add Catalog Item form does.
  defaultIsSerialized Boolean @default(false)

  // Name must be unique per company regardless of where it sits in the
  // tree, no two categories anywhere can share a name, even under
  // different parents (e.g. only one "Cables" category ever exists).
  @@unique([companyId, name])
}

// ─── INVENTORY CUSTOM FIELD ─────────────────────────────────────────────────
// Field definitions only, at this phase. The values (InventoryCustomFieldValue)
// get built in Phase 5 alongside InventoryAsset, since a value has to attach
// to an actual asset record, which doesn't exist yet.
model InventoryCustomField {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  values InventoryCustomFieldValue[]

  // Field names only need to be unique within their own category, two
  // different categories can each have their own "Color" field.
  @@unique([categoryId, name])
}

// ─── INVENTORY STOCK ─────────────────────────────────────────────────────────
// Pooled quantity tracking for non-serialized Catalog Items (cables, mice,
// etc). One row per Catalog Item + Location combination — no individual
// unit records and no Asset Tag, just a running count.
model InventoryStock {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])

  locationId String
  location   InventoryLocation @relation(fields: [locationId], references: [id])

  quantity Int @default(0)

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  inventoryStockEvents InventoryStockEvent[]

  @@unique([catalogItemId, locationId])
}

// ─── INVENTORY ASSET ATTACHMENTS ─────────────────────────────────────────────
model InventoryAssetAttachment {
  id               String         @id @default(cuid())
  assetId          String
  asset            InventoryAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fileName         String
  fileUrl          String
  fileSize         Int?
  uploadedByUserId String
  uploadedByUser   User           @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime       @default(now())
}

// ─── INVENTORY EVENTS (AUDIT TRAIL) ──────────────────────────────────────────
enum InventoryEventType {
  CREATED
  STATUS_CHANGED
  CHECKED_OUT
  RETURNED
  MOVED
  REPAIR_STARTED
  REPAIR_COMPLETED
  FIELD_UPDATED
}

model InventoryAssetEvent {
  id      String         @id @default(cuid())
  assetId String
  asset   InventoryAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  eventType   InventoryEventType
  description String             @db.Text

  // Nullable so future automated events (not directly triggered by
  // someone clicking a button) don't require a fabricated user.
  performedByUserId String?
  performedByUser   User?   @relation(fields: [performedByUserId], references: [id])

  createdAt DateTime @default(now())
}

enum InventoryStockEventType {
  RECEIVED
  CHECKED_OUT
  ADJUSTED
  MOVED
}

model InventoryStockEvent {
  id      String         @id @default(cuid())
  stockId String
  stock   InventoryStock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  eventType      InventoryStockEventType
  // Positive for increases (received, adjusted up), negative for
  // decreases (checked out, adjusted down).
  quantityChange Int
  description    String                  @db.Text

  performedByUserId String?
  performedByUser   User?   @relation(fields: [performedByUserId], references: [id])

  createdAt DateTime @default(now())
}

// ─── INVENTORY LOCATION ─────────────────────────────────────────────────────
model InventoryLocation {
  id              String              @id @default(cuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id])
  name            String
  parentId        String?
  parent          InventoryLocation?  @relation("InventoryLocationChildren", fields: [parentId], references: [id])
  children        InventoryLocation[] @relation("InventoryLocationChildren")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  inventoryAssets InventoryAsset[]
  inventoryStocks InventoryStock[]
}

// ─── CATALOG ITEM ─────────────────────────────────────────────────────────────
model CatalogItem {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  vendorId        String?
  vendor          Vendor?  @relation("CatalogItemVendor", fields: [vendorId], references: [id])
  vendorSku       String?
  manufacturerId  String?
  manufacturer    Vendor?  @relation("CatalogItemManufacturer", fields: [manufacturerId], references: [id])
  manufacturerSku String?
  name            String
  description     String?  @db.Text
  categoryId      String
  categoryRef     Category @relation(fields: [categoryId], references: [id])
  isSerialized    Boolean  @default(false)
  type            ItemType @default(PHYSICAL)
  msrp            Float    @default(0)
  cost            Float    @default(0)
  unit            String   @default("each")
  taxable         Boolean  @default(true)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  quoteLineItems    QuoteLineItem[]
  customPricing     ClientCustomPrice[]
  templateLineItems QuoteTemplateLineItem[]
  soLineItems       SOLineItem[]
  poLineItems       POLineItem[]
  changeLogs        CatalogItemChangeLog[]
  inventoryAssets   InventoryAsset[]
  inventoryStocks   InventoryStock[]
}

// ─── CATALOG ITEM CHANGE LOG ──────────────────────────────────────────────
model CatalogItemChangeLog {
  id              String      @id @default(cuid())
  catalogItemId   String
  catalogItem     CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  changedByUserId String
  changedByUser   User        @relation(fields: [changedByUserId], references: [id])
  fieldName       String
  oldValue        String?
  newValue        String?
  createdAt       DateTime    @default(now())
}

enum ItemType {
  PHYSICAL
  SERVICE
  SUBSCRIPTION
  BUNDLE
}

// ─── CLIENT CUSTOM PRICING ───────────────────────────────────────────────────
model ClientCustomPrice {
  id            String      @id @default(cuid())
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id])
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])
  price         Float
  createdAt     DateTime    @default(now())
}

// ─── QUOTE ───────────────────────────────────────────────────────────────────
model Quote {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  quoteNumber         String
  version             Int            @default(1)
  parentId            String?
  isActive            Boolean        @default(true)
  status              QuoteStatus    @default(DRAFT)
  templateId          String?
  template            QuoteTemplate? @relation(fields: [templateId], references: [id])
  title               String?
  introText           String?        @db.Text
  terms               String?        @db.Text
  useDefaultTerms     Boolean        @default(true)
  internalNotes       String?        @db.Text
  clientPoNumber      String?
  paymentTerms        String?
  shipAddress         String?
  shipAddress2        String?
  shipCity            String?
  shipState           String?
  shipZip             String?
  shipCountry         String?
  shipContactName     String?
  expiresAt           DateTime?
  sentAt              DateTime?
  viewedAt            DateTime?
  acceptedAt          DateTime?
  declinedAt          DateTime?
  declineReason       String?
  signatureType       String?
  signatureData       String?        @db.Text
  signerName          String?
  termsAgreedAt       DateTime?
  portalComment       String?        @db.Text
  portalCommentAt     DateTime?
  lastCommentViewedAt DateTime?
  accessToken         String         @unique @default(cuid())
  internalAccessToken String         @unique @default(cuid())
  taxRate             Float          @default(0)
  pendingEmailPayload Json?
  flagged             Boolean        @default(false)
  sections            String[]       @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems  QuoteLineItem[]
  salesOrder SalesOrder?
  approvals  QuoteApproval[]
  comments   QuoteComment[]
}

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
}

// ─── QUOTE LINE ITEM ─────────────────────────────────────────────────────────
model QuoteLineItem {
  id            String       @id @default(cuid())
  quoteId       String
  quote         Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  catalogItemId String?
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id])

  section            String?
  sortOrder          Int                @default(0)
  name               String
  description        String?            @db.Text
  sku                String?
  quantity           Float              @default(1)
  unitPrice          Float              @default(0)
  cost               Float              @default(0)
  discount           Float              @default(0)
  taxable            Boolean            @default(true)
  isRecurring        Boolean            @default(false)
  recurringInterval  RecurringInterval?
  isOptional         Boolean            @default(false)
  optionalSelected   Boolean            @default(true)
  quantityAdjustable Boolean            @default(false)
  choiceGroup        String?
  isTextBlock        Boolean            @default(false)
  bundleName         String?
  bundleDisplayMode  String?            @default("COLLAPSED")
  isBundleHeader     Boolean            @default(false)
  createdAt          DateTime           @default(now())
}

enum RecurringInterval {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

// ─── SALES ORDER ─────────────────────────────────────────────────────────────
model SalesOrder {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  quoteId   String? @unique
  quote     Quote?  @relation(fields: [quoteId], references: [id])
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  soNumber       String
  clientPoNumber String?
  paymentTerms   String?
  status         SalesOrderStatus @default(DRAFT)
  internalNotes  String?          @db.Text
  clientNotes    String?          @db.Text

  // Billing
  billContactName String?
  billAddress     String?
  billAddress2    String?
  billCity        String?
  billState       String?
  billZip         String?
  billCountry     String?

  // Shipping
  shipContactName String?
  shipAddress     String?
  shipAddress2    String?
  shipCity        String?
  shipState       String?
  shipZip         String?
  shipCountry     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  lineItems      SOLineItem[]
  comments       SOComment[]
  attachments    SOAttachment[]
}

enum SalesOrderStatus {
  DRAFT
  READY_TO_INVOICE
  INVOICED
  READY_TO_ORDER
  PARTS_ORDERED
  READY_TO_CLOSEOUT
  CLOSED
}

// ─── SO LINE ITEM ─────────────────────────────────────────────────────────────
model SOLineItem {
  id                String             @id @default(cuid())
  salesOrderId      String
  salesOrder        SalesOrder         @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  catalogItemId     String?
  catalogItem       CatalogItem?       @relation(fields: [catalogItemId], references: [id])
  vendorId          String?
  vendor            Vendor?            @relation(fields: [vendorId], references: [id])
  name              String
  description       String?            @db.Text
  partNumber        String?
  sku               String?
  vendorSku         String?
  section           String?
  quantity          Float              @default(1)
  unitPrice         Float              @default(0)
  cost              Float              @default(0)
  discount          Float              @default(0)
  taxable           Boolean            @default(true)
  isRecurring       Boolean            @default(false)
  recurringInterval RecurringInterval?
  serialNumber      String?
  isTextBlock       Boolean            @default(false)
  bundleName        String?
  bundleDisplayMode String?            @default("COLLAPSED")
  isBundleHeader    Boolean            @default(false)
  sortOrder         Int                @default(0)
  createdAt         DateTime           @default(now())

  fulfillingPOLineItems POLineItem[]
}

// ─── PURCHASE ORDER ──────────────────────────────────────────────────────────
model PurchaseOrder {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id])
  salesOrderId String?
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])
  vendorId     String
  vendor       Vendor      @relation(fields: [vendorId], references: [id])
  userId       String
  user         User        @relation(fields: [userId], references: [id])

  poNumber      String
  status        POStatus  @default(DRAFT)
  paymentType   String    @default("Net30")
  internalNotes String?   @db.Text
  sentAt        DateTime?
  expectedAt    DateTime?
  receivedAt    DateTime?

  // Shipping — true means it ships straight to the client (pulled from
  // the linked Sales Order's ship-to snapshot); false means it ships to
  // one of your own company's locations (the Client flagged isInternal)
  shipToClient    Boolean @default(false)
  shipContactName String?
  shipAddress     String?
  shipAddress2    String?
  shipCity        String?
  shipState       String?
  shipZip         String?
  shipCountry     String?

  // Since shipAddress above is a frozen text snapshot with no real link
  // to a ClientLocation record, this is set explicitly the first time
  // someone receives a serialized item on this PO, so Inventory knows
  // which of the client's actual locations the resulting assets sit at.
  receivingClientLocationId String?
  receivingClientLocation   ClientLocation? @relation(fields: [receivingClientLocationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems   POLineItem[]
  shipments   POShipment[]
  comments    POComment[]
  attachments POAttachment[]
}

enum POStatus {
  DRAFT
  PARTS_ORDERED
  RECEIVED
  ON_HOLD
  BACKORDERED
  CANCELLED
}

// ─── PO LINE ITEM ─────────────────────────────────────────────────────────────
model POLineItem {
  id                 String             @id @default(cuid())
  purchaseOrderId    String
  purchaseOrder      PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  sourceSOLineItemId String?
  sourceSOLineItem   SOLineItem?        @relation(fields: [sourceSOLineItemId], references: [id])
  catalogItemId      String?
  catalogItem        CatalogItem?       @relation(fields: [catalogItemId], references: [id])
  name               String
  description        String?            @db.Text
  partNumber         String?
  sku                String?
  vendorSku          String?
  quantity           Float              @default(1)
  unitCost           Float              @default(0)
  serialNumber       String?
  received           Boolean            @default(false)
  sortOrder          Int                @default(0)
  createdAt          DateTime           @default(now())
  polineItemSerials  POLineItemSerial[]
}

// ─── PO LINE ITEM SERIALS ──────────────────────────────────────────────────
// One row per physical unit being received on a serialized line item, since
// a single POLineItem.serialNumber field can't hold multiple serials when
// quantity > 1. Each becomes exactly one InventoryAsset once received.
model POLineItemSerial {
  id           String          @id @default(cuid())
  lineItemId   String
  lineItem     POLineItem      @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  serialNumber String
  assetId      String?         @unique
  asset        InventoryAsset? @relation(fields: [assetId], references: [id])
  createdAt    DateTime        @default(now())
}

// ─── PO SHIPMENT ─────────────────────────────────────────────────────────────
model POShipment {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  carrier         String?
  trackingNumber  String?
  shippedAt       DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
}

// ─── QUOTE TEMPLATE ───────────────────────────────────────────────────────
model QuoteTemplate {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  description     String?  @db.Text
  introText       String?  @db.Text
  terms           String?  @db.Text
  useDefaultTerms Boolean  @default(true)
  expiryDays      Int      @default(30)
  active          Boolean  @default(true)
  sections        String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lineItems QuoteTemplateLineItem[]
  quotes    Quote[]
}

model QuoteTemplateLineItem {
  id            String        @id @default(cuid())
  templateId    String
  template      QuoteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  catalogItemId String?
  catalogItem   CatalogItem?  @relation(fields: [catalogItemId], references: [id])

  section            String?
  sortOrder          Int                @default(0)
  name               String
  description        String?            @db.Text
  sku                String?
  quantity           Float              @default(1)
  unitPrice          Float              @default(0)
  cost               Float              @default(0)
  discount           Float              @default(0)
  taxable            Boolean            @default(true)
  isRecurring        Boolean            @default(false)
  recurringInterval  RecurringInterval?
  isOptional         Boolean            @default(false)
  optionalSelected   Boolean            @default(true)
  quantityAdjustable Boolean            @default(false)
  choiceGroup        String?
  isTextBlock        Boolean            @default(false)
  bundleName         String?
  bundleDisplayMode  String?            @default("COLLAPSED")
  isBundleHeader     Boolean            @default(false)
  createdAt          DateTime           @default(now())
}

// ─── DISTRIBUTOR INTEGRATION ─────────────────────────────────────────────────
enum DistributorEnvironment {
  SANDBOX
  PRODUCTION
}

model DistributorIntegration {
  id                String                 @id @default(cuid())
  companyId         String
  company           Company                @relation(fields: [companyId], references: [id])
  distributor       DistributorKey
  enabled           Boolean                @default(false)
  priority          Int                    @default(0)
  activeEnvironment DistributorEnvironment @default(SANDBOX)

  // Sandbox credential fields — not every distributor uses every field
  sandboxApiKey         String?
  sandboxClientId       String?
  sandboxClientSecret   String?
  sandboxPartnerId      String?
  sandboxLastTestStatus String?
  sandboxLastTestedAt   DateTime?

  // Production credential fields — not every distributor uses every field
  productionApiKey         String?
  productionClientId       String?
  productionClientSecret   String?
  productionPartnerId      String?
  productionLastTestStatus String?
  productionLastTestedAt   DateTime?

  accessToken  String? @db.Text
  refreshToken String? @db.Text

  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, distributor])
}

enum DistributorKey {
  INGRAM_MICRO
  TD_SYNNEX
  DH
  AMAZON_BUSINESS
}

// ─── APPROVAL WORKFLOWS ───────────────────────────────────────────────────
model ApprovalWorkflow {
  id             String              @id @default(cuid())
  companyId      String
  company        Company             @relation(fields: [companyId], references: [id])
  name           String
  active         Boolean             @default(true)
  triggerType    ApprovalTriggerType
  thresholdValue Float?
  triggerUserId  String?
  triggerUser    User?               @relation("WorkflowTriggerUser", fields: [triggerUserId], references: [id])
  requiredRoleId String
  requiredRole   Role                @relation(fields: [requiredRoleId], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  approvals QuoteApproval[]
}

enum ApprovalTriggerType {
  TOTAL_THRESHOLD
  DISCOUNT_THRESHOLD
  SPECIFIC_USER
}

model QuoteApproval {
  id               String           @id @default(cuid())
  quoteId          String
  quote            Quote            @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  workflowId       String
  workflow         ApprovalWorkflow @relation(fields: [workflowId], references: [id])
  status           ApprovalStatus   @default(PENDING)
  approvedByUserId String?
  approvedByUser   User?            @relation("ApprovalDecidedBy", fields: [approvedByUserId], references: [id])
  decidedAt        DateTime?
  reason           String?
  createdAt        DateTime         @default(now())

  @@unique([quoteId, workflowId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── MICROSOFT CONNECTIONS ────────────────────────────────────────────────
model MicrosoftConnection {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id])
  label             String
  email             String
  accessToken       String   @db.Text
  refreshToken      String   @db.Text
  connectedByUserId String?
  connectedByUser   User?    @relation(fields: [connectedByUserId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  usedAsQuoteSenderBy CompanySettings[]

  @@unique([companyId, email])
}

// ─── QUOTE COMMENTS ─────────────────────────────────────────────────────
model QuoteComment {
  id           String   @id @default(cuid())
  quoteId      String
  quote        Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  authorType   String // "INTERNAL" | "CLIENT"
  authorUserId String?
  authorUser   User?    @relation(fields: [authorUserId], references: [id])
  authorName   String
  message      String   @db.Text
  createdAt    DateTime @default(now())
}

// ─── SALES ORDER COMMENTS ────────────────────────────────────────────────
model SOComment {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  authorUserId String
  authorUser   User       @relation(fields: [authorUserId], references: [id])
  authorName   String
  message      String     @db.Text
  createdAt    DateTime   @default(now())
}

// ─── PURCHASE ORDER COMMENTS ──────────────────────────────────────────────
model POComment {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  authorUserId    String
  authorUser      User          @relation(fields: [authorUserId], references: [id])
  authorName      String
  message         String        @db.Text
  createdAt       DateTime      @default(now())
}

// ─── SALES ORDER ATTACHMENTS ──────────────────────────────────────────────
model SOAttachment {
  id               String     @id @default(cuid())
  salesOrderId     String
  salesOrder       SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  fileName         String
  fileUrl          String
  fileSize         Int?
  uploadedByUserId String
  uploadedByUser   User       @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime   @default(now())
}

// ─── PURCHASE ORDER ATTACHMENTS ───────────────────────────────────────────
model POAttachment {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  fileName         String
  fileUrl          String
  fileSize         Int?
  uploadedByUserId String
  uploadedByUser   User          @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime      @default(now())
}

// ─── NOTIFICATION ─────────────────────────────────────────────────────────
model Notification {
  id        String           @id @default(cuid())
  companyId String
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

enum NotificationType {
  QUOTE_VIEWED
  QUOTE_APPROVED
  QUOTE_LOST
  QUOTE_COMMENT
  SO_READY_TO_INVOICE
  SO_READY_TO_ORDER
  SO_READY_TO_CLOSEOUT
}

// ─── ROLE ────────────────────────────────────────────────────────────────
model Role {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  // Higher rank = more senior, used for "X or higher" comparisons (e.g.
  // approval workflows, who can decide a pending approval)
  rank        Int      @default(0)
  // Every permission toggle lives here as one flexible object instead of a
  // dedicated column per permission, so adding new permissions later never
  // needs a migration. Shape (all booleans unless noted):
  // {
  //   pages: { clients, catalog, vendors, quotes, settings, salesOrders, purchaseOrders },
  //   quotes: { create, edit, delete, changeStatus, approve, sendEmail, viewAllUsersQuotes },
  //   clients: { create, edit, delete, viewAllClients },
  //   salesOrders: { create, edit, delete, changeStatus, generatePO },
  //   purchaseOrders: { create, edit, delete, changeStatus, send },
  //   settingsSections: { company, users, quotes, approvalWorkflows, notifications, integrations },
  //   maxDiscount: number
  // }
  permissions Json
  // System roles are the 5 starter roles created during migration — kept
  // distinguishable so we can decide later whether to protect them from
  // deletion (e.g. don't let the last Admin-equivalent role be deleted)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users             User[]
  approvalWorkflows ApprovalWorkflow[]

  @@unique([companyId, name])
}

// ─── INVENTORY ASSET ─────────────────────────────────────────────────────────
enum InventoryAssetStatus {
  IN_STOCK
  INTERNAL
  LOANED
  SOLD
  IN_REPAIR
  REMOVED
}

enum InventoryOwnerType {
  COMPANY
  CLIENT
}

enum InventoryRemovedReason {
  BROKEN_SCRAPPED
  LOST
  DONATED
  RETURNED_TO_VENDOR
  OTHER
}

enum InventoryRepairType {
  SELF
  VENDOR
}

model InventoryAsset {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])

  assetTag     String
  serialNumber String?

  status    InventoryAssetStatus @default(IN_STOCK)
  ownerType InventoryOwnerType   @default(COMPANY)

  // Set only when ownerType is CLIENT (permanent, e.g. Sold, or shipped
  // directly to a client on receipt and never touched our own stock).
  ownerClientId String?
  ownerClient   Client? @relation("InventoryAssetOwner", fields: [ownerClientId], references: [id])

  // Company-owned warehouse position. Only meaningful while ownerType is
  // COMPANY, kept around even while checked out so its last known shelf
  // spot isn't lost.
  locationId String?
  location   InventoryLocation? @relation(fields: [locationId], references: [id])

  // Which of the owning client's own sites this sits at, for client-owned assets.
  clientLocationId String?
  clientLocation   ClientLocation? @relation(fields: [clientLocationId], references: [id])

  // Internal checkout holder — one of our own staff, permanent until changed.
  assignedUserId String?
  assignedUser   User?   @relation("InventoryAssetAssignedUser", fields: [assignedUserId], references: [id])

  // Loaned checkout holder — client-only, with an expected return date.
  loanedToClientId       String?
  loanedToClient         Client?   @relation("InventoryAssetLoanedTo", fields: [loanedToClientId], references: [id])
  loanedToContactId      String?
  loanedToContact        Contact?  @relation(fields: [loanedToContactId], references: [id])
  loanExpectedReturnDate DateTime?

  removedReason InventoryRemovedReason?

  repairType                InventoryRepairType?
  repairEstimatedReturnDate DateTime?
  // Remembers the status this asset was in right before it went IN_REPAIR,
  // so "Back to Origin" after repair can restore it automatically.
  statusBeforeRepair        InventoryAssetStatus?

  warrantyType       String?
  warrantyExpiration DateTime?

  // Per-unit overrides — null means "use the Catalog Item's value."
  overrideVendorId        String?
  overrideVendor          Vendor? @relation("InventoryAssetOverrideVendor", fields: [overrideVendorId], references: [id])
  overrideVendorSku       String?
  overrideManufacturerId  String?
  overrideManufacturer    Vendor? @relation("InventoryAssetOverrideManufacturer", fields: [overrideManufacturerId], references: [id])
  overrideManufacturerSku String?

  notes String? @db.Text

  customFieldValues InventoryCustomFieldValue[]

  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  inventoryAssetEvents      InventoryAssetEvent[]
  inventoryAssetAttachments InventoryAssetAttachment[]
  polineItemSerial          POLineItemSerial?

  // Asset Tags are generated from the owning client's prefix + a running
  // sequence, unique per company (not globally), since two different
  // companies on this platform could each independently generate "ACM-0001".
  @@unique([companyId, assetTag])
}

model InventoryCustomFieldValue {
  id            String               @id @default(cuid())
  assetId       String
  asset         InventoryAsset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  customFieldId String
  customField   InventoryCustomField @relation(fields: [customFieldId], references: [id])
  value         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([assetId, customFieldId])
}
