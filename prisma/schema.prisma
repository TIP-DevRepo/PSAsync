// ─── PURCHASE ORDER ──────────────────────────────────────────────────────────
model PurchaseOrder {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id])
  salesOrderId String?
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])
  vendorId     String
  vendor       Vendor      @relation(fields: [vendorId], references: [id])
  userId       String
  user         User        @relation(fields: [userId], references: [id])

  poNumber      String
  status        POStatus  @default(DRAFT)
  paymentType   String    @default("Net30")
  internalNotes String?   @db.Text
  sentAt        DateTime?
  expectedAt    DateTime?
  receivedAt    DateTime?

  // Shipping — true means it ships straight to the client (pulled from
  // the linked Sales Order's ship-to snapshot); false means it ships to
  // one of your own company's locations (the Client flagged isInternal)
  shipToClient    Boolean @default(false)
  // Which client this actually ships to when shipToClient is true — set
  // from the linked Sales Order's client if one exists, or picked
  // directly on a standalone PO. This is the real link Inventory uses
  // to resolve ownership and Asset Tag prefix, not the Sales Order.
  shipToClientId  String?
  shipToClientRef Client? @relation(fields: [shipToClientId], references: [id])
  shipContactName String?
  shipAddress     String?
  shipAddress2    String?
  shipCity        String?
  shipState       String?
  shipZip         String?
  shipCountry     String?

  // Fallback only — used when no real location was captured at creation
  // (e.g. a PO generated from a Sales Order, which has the same
  // text-snapshot-only shipping problem). Set the first time someone
  // receives on this PO if shipToClientLocationId is empty.
  receivingClientLocationId String?
  receivingClientLocation   ClientLocation? @relation("PurchaseOrderReceivingLocation", fields: [receivingClientLocationId], references: [id])

  // The real link, captured at creation time on a standalone ship-to-
  // client PO from the client + location picker on the New Purchase
  // Order page. When this is set, receiving never needs to ask again.
  shipToClientLocationId String?
  shipToClientLocation   ClientLocation? @relation("PurchaseOrderShipToLocation", fields: [shipToClientLocationId], references: [id])

  // The opportunity this order belongs to, if any. Deleting a linked
  // opportunity is refused by the app, and by the database.
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems   POLineItem[]
  shipments   POShipment[]
  comments    POComment[]
  attachments POAttachment[]

  @@index([opportunityId])
}

enum POStatus {
  DRAFT
  PARTS_ORDERED
  RECEIVED
  ON_HOLD
  BACKORDERED
  CANCELLED
}

