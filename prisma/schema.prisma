// ─── ROLE ────────────────────────────────────────────────────────────────
model Role {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  // Higher rank = more senior, used for "X or higher" comparisons (e.g.
  // approval workflows, who can decide a pending approval)
  rank          Int      @default(0)
  // Every permission toggle lives here as one flexible object instead of a
  // dedicated column per permission, so adding new permissions later never
  // needs a migration. Shape (all booleans unless noted):
  // {
  //   pages: { clients, catalog, vendors, quotes, settings, salesOrders, purchaseOrders },
  //   quotes: { create, edit, delete, changeStatus, approve, sendEmail, viewAllUsersQuotes },
  //   clients: { create, edit, delete, viewAllClients },
  //   salesOrders: { create, edit, delete, changeStatus, generatePO },
  //   purchaseOrders: { create, edit, delete, changeStatus, send },
  //   settingsSections: { company, users, quotes, approvalWorkflows, notifications, integrations },
  //   maxDiscount: number
  // }
  permissions   Json
  // System roles are the 5 starter roles created during migration — kept
  // distinguishable so we can decide later whether to protect them from
  // deletion (e.g. don't let the last Admin-equivalent role be deleted)
  isSystem      Boolean  @default(false)
  // The one locked, permission-immune role every company has. Checked by
  // id/flag rather than by matching the "Global Admin" name so renaming
  // the role can never break the bypass in hasPermission/getUserRank.
  // Cannot be edited or deleted (see src/app/api/roles/[id]/route.ts) and
  // enforced unique per company by a partial index (see migration SQL).
  isGlobalAdmin Boolean  @default(false)
  // The implicit base role every user in the company holds without a
  // UserRole row. Always the lowest rank, never Global Admin, can't be
  // assigned, removed, renamed, or deleted, but its permissions stay
  // editable. Enforced unique per company by a partial index, and kept
  // from ever also being Global Admin by a check constraint (see the
  // add_multi_role_support migration SQL).
  isEveryone    Boolean  @default(false)
  // Hex color string (e.g. "#5865F2"), reserved for the role picker UI.
  color         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users             User[]
  userRoles         UserRole[]         @relation("UserRoleRole")
  approvalWorkflows ApprovalWorkflow[]
  teamDefaultRoles  TeamDefaultRole[]

  @@unique([companyId, name])
}

// ─── USER ROLE ───────────────────────────────────────────────────────────────
// Which roles a user holds. A user's permissions are the union of every
// role here plus their company's Everyone role (which never gets a row).
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation("UserRoleRole", fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// ─── TEAMS ───────────────────────────────────────────────────────────────────
// Admin managed groups of users, shared by opportunities now and tickets
// later. A user can be in several teams. Every company has one default
// catch all team (isDefault, named General when it is created), which can be
// renamed but never deleted; src/lib/team-defaults.ts creates it on first
// use. A team's default roles are granted to its members while they are in
// it, worked out when permissions are resolved (getEffectiveAccess), never
// copied into UserRole.
model Team {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String?
  // Exactly one per company: the General team
  isDefault   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       TeamMember[]
  defaultRoles  TeamDefaultRole[]
  opportunities Opportunity[]

  @@unique([companyId, name])
  @@index([companyId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

// Roles every member of the team holds while they are in it
model TeamDefaultRole {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([teamId, roleId])
  @@index([roleId])
}

// ─── INVENTORY ASSET ─────────────────────────────────────────────────────────
enum InventoryAssetStatus {
  IN_STOCK
  INTERNAL
  LOANED
  SOLD
  PENDING_OFFBOARD
  REMOVED
}

enum InventorySoldReturnReason {
  REFUND
  DISPOSAL
  HOLDING_STOCK
}

enum InventoryOwnerType {
  COMPANY
  CLIENT
}

enum InventoryRemovedReason {
  BROKEN_SCRAPPED
  LOST
  DONATED
  RETURNED_TO_VENDOR
  OTHER
}

model InventoryAsset {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])

  assetTag     String
  serialNumber String?

  status    InventoryAssetStatus @default(IN_STOCK)
  ownerType InventoryOwnerType   @default(COMPANY)

  // Set only when ownerType is CLIENT (permanent, e.g. Sold, or shipped
  // directly to a client on receipt and never touched our own stock).
  ownerClientId String?
  ownerClient   Client? @relation("InventoryAssetOwner", fields: [ownerClientId], references: [id])

  // Which Container this sits in, if it's stocked at an onboarded site
  // (either our own or a client's, since both now work the same way).
  // Kept around even while checked out so its last known shelf spot
  // isn't lost.
  locationId String?
  location   InventoryLocation? @relation(fields: [locationId], references: [id])

  // Which of the owning client's own sites this sits at, for client-owned assets.
  clientLocationId String?
  clientLocation   ClientLocation? @relation(fields: [clientLocationId], references: [id])

  // Internal checkout holder — one of our own staff, permanent until changed.
  assignedUserId String?
  assignedUser   User?   @relation("InventoryAssetAssignedUser", fields: [assignedUserId], references: [id])

  // Loaned checkout holder — client-only, with an expected return date.
  loanedToClientId       String?
  loanedToClient         Client?   @relation("InventoryAssetLoanedTo", fields: [loanedToClientId], references: [id])
  loanedToContactId      String?
  loanedToContact        Contact?  @relation("InventoryAssetLoanedToContact", fields: [loanedToContactId], references: [id])
  loanExpectedReturnDate DateTime?

  // Who at the client currently holds this asset once Sold and Deployed —
  // Loaned already tracks this via loanedToContactId above, this is the
  // Sold-path equivalent.
  deployedToContactId String?
  deployedToContact   Contact? @relation("InventoryAssetDeployedToContact", fields: [deployedToContactId], references: [id])

  // Set only when a Sold return's reason was Disposal. Persists through
  // the Pending Offboard -> Offboarded flow untouched — only a future
  // "Mark as E-Wasted" action (Phase 11) clears it.
  pendingDisposal Boolean @default(false)

  removedReason InventoryRemovedReason?

  warrantyType       String?
  warrantyExpiration DateTime?

  // Per-unit overrides — null means "use the Catalog Item's value."
  overrideVendorId        String?
  overrideVendor          Vendor? @relation("InventoryAssetOverrideVendor", fields: [overrideVendorId], references: [id])
  overrideVendorSku       String?
  overrideManufacturerId  String?
  overrideManufacturer    Vendor? @relation("InventoryAssetOverrideManufacturer", fields: [overrideManufacturerId], references: [id])
  overrideManufacturerSku String?

  notes String? @db.Text

  customFieldValues InventoryCustomFieldValue[]

  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  inventoryAssetEvents      InventoryAssetEvent[]
  inventoryAssetAttachments InventoryAssetAttachment[]
  polineItemSerial          POLineItemSerial?

  // Asset Tags are generated from the owning client's prefix + a running
  // sequence, unique per company (not globally), since two different
  // companies on this platform could each independently generate "ACM-0001".
  @@unique([companyId, assetTag])
}

model InventoryCustomFieldValue {
  id            String               @id @default(cuid())
  assetId       String
  asset         InventoryAsset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  customFieldId String
  customField   InventoryCustomField @relation(fields: [customFieldId], references: [id])
  value         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([assetId, customFieldId])
}

// ─── DASHBOARD ───────────────────────────────────────────────────────────────
enum WidgetType {
  INVENTORY_BY_STATUS
  INVENTORY_BY_CLIENT
  OPEN_QUOTES
  OPEN_POS
  TOTAL_CLIENTS
}

enum WidgetSize {
  SMALL
  MEDIUM
  LARGE
}

model Dashboard {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Null only for the one shared, company wide Default dashboard. Every
  // personal dashboard belongs to exactly one user and is deleted along
  // with them.
  userId String?
  user   User?   @relation("DashboardOwner", fields: [userId], references: [id], onDelete: Cascade)

  name      String
  isDefault Boolean @default(false)

  // Users who've picked this specific dashboard as the one that loads
  // for them at /dashboard — separate from isDefault above, which is
  // the one shared company wide fallback everyone sees until they pick
  // their own.
  usersDefaultingHere User[] @relation("UserDefaultDashboard")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  widgets DashboardWidget[]
}

model DashboardWidget {
  id          String    @id @default(cuid())
  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  widgetType WidgetType
  size       WidgetSize @default(MEDIUM)

  // Top-left grid cell this widget occupies, 0-indexed against the fixed
  // 4x4 grid. A widget's footprint (from its size) extends right/down
  // from here — see src/lib/dashboards/gridPlacement.ts, the single
  // source of truth for size-to-footprint and overlap checking, used by
  // both the client (drag preview) and the API (authoritative check).
  row Int @default(0)
  col Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── OPPORTUNITIES ───────────────────────────────────────────────────────────
// A sales pipeline record between a ticket and a quote. Stages, types, and
// settings are per company and created lazily by ensureOpportunityDefaults
// (src/lib/opportunity-defaults.ts) the first time an opportunity route
// runs for a company.

enum OpportunityStageCategory {
  OPEN
  WON
  LOST
}

enum OpportunitySource {
  MANUAL
  TICKET
  QUOTE
}

model OpportunityStage {
  id             String                   @id @default(cuid())
  companyId      String
  company        Company                  @relation(fields: [companyId], references: [id])
  name           String
  category       OpportunityStageCategory
  sortOrder      Int                      @default(0)
  // A whole number from 0 to 100, checked by the API
  winProbability Int                      @default(0)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  opportunities        Opportunity[]
  quoteSentForSettings OpportunitySettings[] @relation("OpportunitySettingsQuoteSentStage")
  actionButtons        ActionButton[]

  @@index([companyId])
}

model OpportunityType {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunities Opportunity[]

  @@index([companyId])
}

// One per company. The row is also what keeps the lazy defaults from being
// created twice: the request that inserts it creates the stages and types
// in the same transaction, and a request racing it waits on the unique
// companyId and then finds the row already there.
model OpportunitySettings {
  id               String            @id @default(cuid())
  companyId        String            @unique
  company          Company           @relation(fields: [companyId], references: [id])
  // Number prefix, the same rule as the quote prefix (src/lib/number-prefix.ts)
  prefix           String            @default("OPP")
  // The sequence the next new opportunity's number takes, handed out with
  // one atomic increment per opportunity (src/lib/opportunity-number.ts)
  nextNumber       Int               @default(1)
  // The stage a sent quote moves its opportunity to. Must be an OPEN stage.
  quoteSentStageId String?
  quoteSentStage   OpportunityStage? @relation("OpportunitySettingsQuoteSentStage", fields: [quoteSentStageId], references: [id], onDelete: Restrict)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Opportunity {
  id                String            @id @default(cuid())
  companyId         String
  company           Company           @relation(fields: [companyId], references: [id])
  number            String
  title             String
  clientId          String
  client            Client            @relation(fields: [clientId], references: [id])
  // Always a contact of clientId, checked by the API
  contactId         String
  contact           Contact           @relation(fields: [contactId], references: [id])
  // A location of clientId, by default the client's main location (its
  // primary location, else its main billing location; see
  // src/lib/client-main-location.ts). Null when the client has none.
  clientLocationId  String?
  clientLocation    ClientLocation?   @relation(fields: [clientLocationId], references: [id], onDelete: SetNull)
  // Null means unassigned
  ownerId           String?
  owner             User?             @relation("OpportunityOwner", fields: [ownerId], references: [id])
  stageId           String
  stage             OpportunityStage  @relation(fields: [stageId], references: [id], onDelete: Restrict)
  typeId            String?
  type              OpportunityType?  @relation(fields: [typeId], references: [id], onDelete: Restrict)
  source            OpportunitySource @default(MANUAL)
  expectedValue     Decimal?          @db.Decimal(12, 2)
  expectedCloseDate DateTime?
  // The ticket this opportunity came from. A plain id with no relation
  // because tickets don't exist yet; Phase 2 or 3 adds the relation.
  sourceTicketId    String?
  stageChangedAt    DateTime          @default(now())
  // Set when the opportunity moves into a WON or LOST stage, cleared when
  // it moves back to an OPEN one
  closedAt          DateTime?
  // Every opportunity has a team (src/lib/team-defaults.ts creates the
  // General team and moves every opportunity without one into it, and
  // createOpportunity always sets one). Nullable only so this column could
  // be added to a table that already had rows, without a backfill inside
  // the migration; the app never writes null.
  teamId            String?
  team              Team?             @relation(fields: [teamId], references: [id], onDelete: Restrict)
  createdById       String
  createdBy         User              @relation("OpportunityCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  // Set when the opportunity is deleted. Deleting only hides it: the row,
  // its attachments, and its timeline are kept so an admin can restore it
  // from the audit log. Every opportunity query leaves deleted ones out
  // (NOT_DELETED_OPPORTUNITY in src/lib/scoped-loaders.ts).
  deletedAt         DateTime?
  deletedById       String?
  deletedBy         User?             @relation("OpportunityDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  attachments    OpportunityAttachment[]
  timeline       TimelineEntry[]
  quotes         Quote[]
  salesOrders    SalesOrder[]
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([stageId])
  @@index([ownerId])
  @@index([clientId])
  @@index([clientLocationId])
  @@index([teamId])
  @@index([companyId, deletedAt])
}

// ─── OPPORTUNITY ATTACHMENTS ──────────────────────────────────────────────
// Same fields and scoping as SOAttachment: tied to its opportunity, which
// carries the company
model OpportunityAttachment {
  id               String      @id @default(cuid())
  opportunityId    String
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fileName         String
  fileUrl          String
  fileSize         Int?
  uploadedByUserId String
  uploadedByUser   User        @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime    @default(now())
}

// ─── TIMELINE ────────────────────────────────────────────────────────────────
// The activity history of a record, newest first on its page: notes users
// write, actions the app records as things change, and later emails in and
// out. Opportunities use it first; tickets (a later phase) reuse the same
// model, route pattern, and UI component (src/lib/timeline.ts,
// src/components/timeline/).

enum TimelineEntryKind {
  NOTE
  ACTION
  // Unused until the mailbox phase records emails on the timeline
  EMAIL_OUT
  EMAIL_IN
}

model TimelineEntry {
  id            String            @id @default(cuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id])
  // The record the entry belongs to. Tickets add their own nullable link
  // later; an entry belongs to exactly one record.
  opportunityId String?
  opportunity   Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  kind          TimelineEntryKind
  // Null means the system (or a user since deleted)
  authorId      String?
  author        User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  // NOTE entries: rich text HTML, sanitized on save and when returned
  body          String?           @db.Text
  // ACTION entries: what happened, for example stage_changed
  action        String?
  // ACTION entries: the before and after values, with names as well as ids
  data          Json?
  editedAt      DateTime?
  createdAt     DateTime          @default(now())

  @@index([companyId])
  @@index([opportunityId, createdAt])
}

// ─── RATE LIMITS ──────────────────────────────────────────────────────────────
// Fixed window counters for IP based rate limiting (src/lib/rate-limit.ts).
// Only failures are counted (plus every call for keys with no failure
// state). hashedIp is sha256 of the key and the IP, never the raw IP. Rows
// older than two days are deleted by the limiter itself. Not company scoped.
model RateLimit {
  id          String   @id @default(cuid())
  // What is limited, e.g. "login", "portal", "sso-lookup"
  key         String
  hashedIp    String
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, hashedIp, windowStart])
  @@index([windowStart])
  @@map("rate_limits")
}

// ─── ACTION BUTTONS ──────────────────────────────────────────────────────────
// What an action button does. Only the kinds in AVAILABLE_ACTION_KINDS
// (src/lib/timeline-buttons.ts) show on records; the rest can be set up
// now and appear once their feature exists.
enum ActionButtonKind {
  NOTE
  EMAIL
  RAISE_QUOTE
  APPOINTMENT
  CHILD_TICKET
}

// Whether a NOTE or EMAIL button changes the record's stage: never, a
// stage the user picks, or one fixed stage
enum ActionStageMode {
  NONE
  CHOOSE
  FIXED
}

enum ActionNoteMode {
  OPTIONAL
  REQUIRED
}

// The admin defined buttons above a record's timeline (the HaloPSA style
// "actions"), shared by opportunities and tickets. Defaults are created by
// ensureActionButtonDefaults (src/lib/action-buttons.ts). Tickets add a
// fixed ticket status field later, next to fixedStageId.
model ActionButton {
  id               String            @id @default(cuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id])
  label            String
  // A name from ACTION_BUTTON_ICONS (src/lib/timeline-buttons.ts)
  icon             String
  // #RRGGBB
  color            String
  forOpportunities Boolean           @default(true)
  forTickets       Boolean           @default(false)
  kind             ActionButtonKind
  stageMode        ActionStageMode   @default(NONE)
  // The stage a FIXED button moves an opportunity to. A stage a button
  // points at can't be deleted.
  fixedStageId     String?
  fixedStage       OpportunityStage? @relation(fields: [fixedStageId], references: [id], onDelete: Restrict)
  noteMode         ActionNoteMode    @default(REQUIRED)
  isHidden         Boolean           @default(false)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([companyId])
}

// ─── AUDIT LOG ───────────────────────────────────────────────────────────────
// The kind of record an audit entry is about. Only OPPORTUNITY is recorded
// so far; later branches record tickets, quotes, sales orders, and
// purchase orders with the other values.
enum AuditRecordType {
  OPPORTUNITY
  TICKET
  QUOTE
  SALES_ORDER
  PURCHASE_ORDER
}

// The admin record of every change, kept forever (src/lib/audit-log.ts).
// Written with recordAudit inside the same transaction as the change it
// describes. recordId has no relation, so entries outlive their records,
// and every name is stored next to its id (recordLabel, actorName, and the
// refs in before and after), so an entry reads correctly after a rename or
// delete.
model AuditLogEntry {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id])
  recordType  AuditRecordType
  recordId    String
  // A snapshot of the record's name, for example "OPP-2026-0007 New laptops"
  recordLabel String
  // What happened, for example created, field_changed, deleted, restored,
  // note_added, undone (AUDIT_ACTIONS in src/lib/audit-values.ts)
  action      String
  // The field a field_changed or undone entry is about (its PATCH body key)
  field       String?
  before      Json?
  after       Json?
  // Null is the system (or a user since deleted)
  actorId     String?
  actor       User?           @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName   String
  // Set on a field_changed entry once it has been undone
  undoneAt    DateTime?
  undoneById  String?
  undoneBy    User?           @relation("AuditLogUndoneBy", fields: [undoneById], references: [id], onDelete: SetNull)
  // On an undone entry, the entry it reverses
  undoOfId    String?
  createdAt   DateTime        @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, recordType, recordId, createdAt])
}
